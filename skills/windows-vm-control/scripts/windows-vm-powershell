#!/usr/bin/env python3
"""Run normalized UTF-8 scripts through one streaming Windows job-supervised path."""
import argparse
import base64
import json
import os
import signal
from pathlib import Path
import subprocess
import sys
import tempfile
import uuid


def encoded(source):
    return base64.b64encode(source.encode('utf-16le')).decode('ascii')


def command(source):
    return ('C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe '
            '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass '
            '-OutputFormat Text -EncodedCommand ' + encoded(source))


def quote(value):
    return "'" + value.replace("'", "''") + "'"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--ssh')
    parser.add_argument('--timeout', type=int, default=30)
    parser.add_argument('script')
    args = parser.parse_args()
    path = Path(args.script)
    if args.timeout <= 0:
        parser.error('timeout must be positive')
    if not path.is_absolute() or path.suffix.lower() != '.ps1' or not path.is_file():
        parser.error('script must be an existing absolute .ps1 path')
    try:
        source = path.read_text(encoding='utf-8-sig')
    except (OSError, UnicodeError) as error:
        print(f'Cannot read UTF-8 script: {error}', file=sys.stderr)
        return 65
    config_path = Path(os.environ.get('WINDOWS_VM_CONTROL_CONFIG',
        str(Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home()/'.config'))) / 'windows-vm-control/config.json')))
    config = json.loads(config_path.read_text()) if config_path.exists() else {}
    host = args.ssh or os.environ.get('WINDOWS_VM_SSH_ALIAS') or config.get('ssh_alias', 'windows-vm')
    opts = ['-o','BatchMode=yes','-o','ConnectTimeout=5','-o','ConnectionAttempts=1',
            '-o','ServerAliveInterval=5','-o','ServerAliveCountMax=3']
    runner = Path(__file__).with_name('powershell-runner.ps1')
    if not runner.is_file():
        print('Missing powershell-runner.ps1', file=sys.stderr)
        return 69
    guest_files = []
    result = 1
    try:
        probe = subprocess.run(['ssh', '-n', *opts, host,
            command('[Console]::Out.Write($env:TEMP)')], capture_output=True, timeout=10)
        if probe.returncode:
            sys.stderr.buffer.write(probe.stderr)
            return probe.returncode
        temp = probe.stdout.decode('utf-8').strip()
        if not temp or '\n' in temp or '\r' in temp:
            raise ValueError('Invalid Windows temporary path')
        stem = temp + '\\windows-vm-control-' + uuid.uuid4().hex
        guest_files = [stem+'.ps1', stem+'-runner.ps1']
        with tempfile.TemporaryDirectory(prefix='windows-powershell-') as local:
            normalized = Path(local)/'task.ps1'
            normalized.write_text(source, encoding='utf-8-sig')
            for src, dst in zip([normalized, runner], guest_files):
                transfer = subprocess.run(['scp', *opts, '--', str(src), host+':'+dst.replace('\\','/')], timeout=15)
                if transfer.returncode:
                    result = transfer.returncode
                    break
            else:
                invocation = '& '+quote(guest_files[1])+' -TaskPath '+quote(guest_files[0])+f' -TimeoutSeconds {args.timeout}; exit $LASTEXITCODE'
                # The guest owns the task deadline. This outer bound covers setup/transport failure.
                process = subprocess.run(['ssh', *opts, host, command(invocation)], timeout=args.timeout+30)
                result = process.returncode
    except subprocess.TimeoutExpired:
        print('transport_timeout=unverified; guest task has its own deadline', file=sys.stderr)
        result = 76
    except KeyboardInterrupt:
        # Do not claim an SSH disconnect stopped Windows. The guest job still enforces its deadline.
        print('transport_interrupted=unverified; guest task has its own deadline', file=sys.stderr)
        result = 76
    except (OSError, ValueError) as error:
        print(str(error), file=sys.stderr)
        result = 75
    finally:
        if guest_files:
            paths = ','.join(quote(p) for p in guest_files)
            cleanup = f'$ErrorActionPreference="Stop"; foreach ($p in @({paths})) {{ if (Test-Path -LiteralPath $p) {{ Remove-Item -LiteralPath $p -Force }}; if (Test-Path -LiteralPath $p) {{ exit 76 }} }}'
            try:
                cleaned = subprocess.run(['ssh','-n',*opts,host,command(cleanup)], capture_output=True, timeout=10)
                if cleaned.returncode:
                    result = 76
                    print('cleanup=unverified guest_scripts='+repr(guest_files), file=sys.stderr)
            except (OSError, subprocess.TimeoutExpired):
                result = 76
                print('cleanup=unverified guest_scripts='+repr(guest_files), file=sys.stderr)
    return result


if __name__ == '__main__':
    def interrupted(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    sys.exit(main())
