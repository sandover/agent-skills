#!/bin/zsh
# Restore OpenSSH through VMware Guest Operations without requiring SSH or a desktop login.
# Resolve the target account and public key from the SSH alias and the Mac address from the VM route.
# Refuse trust errors, route mismatches, and failures that OpenSSH restoration cannot repair.
# Run one bundled elevated PowerShell implementation with bounded polling and task-owned cleanup.
# Verify recovered SSH independently and report administrator, timeout, and cleanup failures distinctly.

set -u

usage() {
  print -u2 'usage: windows-vm-recover-ssh [--timeout SECONDS]'
}

script_dir=${0:A:h}
vmrun="$script_dir/windows-vmrun"
status_script="$script_dir/windows-vm-status"
restore_script="$script_dir/restore-openssh.ps1"
config_root="${XDG_CONFIG_HOME:-${HOME}/.config}"
config_path="${WINDOWS_VM_CONTROL_CONFIG:-${config_root}/windows-vm-control/config.json}"

read_config() {
  local key=$1
  if [[ -f "$config_path" ]]; then
    /usr/bin/plutil -extract "$key" raw -o - "$config_path" 2>/dev/null || true
  fi
}

ssh_host="${WINDOWS_VM_SSH_ALIAS:-$(read_config ssh_alias)}"
ssh_host="${ssh_host:-windows-vm}"
timeout_seconds=180

while (( $# > 0 )); do
  case "$1" in
    --timeout)
      (( $# >= 2 )) || { usage; exit 64; }
      [[ "$2" == <-> && "$2" != 0 ]] || { print -u2 'timeout must be a positive integer'; exit 64; }
      timeout_seconds=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      print -u2 -r -- "unknown argument: $1"
      usage
      exit 64
      ;;
  esac
done

[[ -x "$vmrun" && -x "$status_script" && -r "$restore_script" ]] || {
  print -u2 'Windows VM recovery helpers are missing or not executable'
  exit 69
}

status_output=$("$status_script" --ssh "$ssh_host" --require ssh --wait 0 2>&1)
status_result=$?
ssh_state=$(print -r -- "$status_output" | /usr/bin/awk -F= '$1 == "ssh" { print $2; exit }')
if (( status_result == 0 )); then
  print -r -- "$status_output"
  print 'recovery=not_needed'
  exit 0
fi
case "$ssh_state" in
  timeout|refused|authentication_failed) ;;
  alias_unresolved|host_key_failed|probe_failed|failed)
    print -u2 -r -- "$status_output"
    print -u2 -r -- "recovery=refused ssh=$ssh_state"
    exit 75
    ;;
  *)
    print -u2 -r -- "$status_output"
    print -u2 -r -- "recovery=refused ssh=${ssh_state:-unknown}"
    exit 75
    ;;
esac

"$vmrun" doctor --require guest-ops || { print -u2 'guest_operations=unavailable'; exit 71; }

ssh_config=$(ssh -G "$ssh_host" 2>/dev/null) || { print -u2 'could not read SSH alias configuration'; exit 78; }
ssh_route=$(print -r -- "$ssh_config" | /usr/bin/awk '$1 == "hostname" { print $2; exit }')
[[ -n "$ssh_route" ]] || { print -u2 'SSH alias has no host name'; exit 78; }

guest_ip=$("$vmrun" getGuestIPAddress 2>/dev/null)
guest_result=$?
guest_ip=${guest_ip//$'\r'/}
if (( guest_result != 0 )) || [[ -z "$guest_ip" || "$guest_ip" == *$'\n'* ]]; then
  print -u2 'guest_ip=unavailable'
  exit 71
fi
if [[ "$ssh_route" != "$guest_ip" ]]; then
  print -u2 -r -- "route_match=no ssh_host=$ssh_route guest_ip=$guest_ip"
  print -u2 'Update the SSH alias only after confirming the VM host-key fingerprint.'
  exit 75
fi

windows_user=$(print -r -- "$ssh_config" | /usr/bin/awk '$1 == "user" { print $2; exit }')
[[ -n "$windows_user" && "$windows_user" != *$'\n'* && "$windows_user" != *'\'* && "$windows_user" != *'@'* ]] || {
  print -u2 'SSH alias must name one local Windows user'
  exit 78
}

local_identity=''
public_key_path=''
identity_files=("${(@f)$(print -r -- "$ssh_config" | /usr/bin/awk '$1 == "identityfile" { print $2 }')}")
for candidate in "${identity_files[@]}"; do
  candidate=${candidate//\%d/$HOME}
  candidate=${candidate/#\~/$HOME}
  if [[ -f "${candidate}.pub" ]]; then
    local_identity=$candidate
    public_key_path="${candidate}.pub"
    break
  fi
done
[[ -n "$local_identity" ]] || {
  print -u2 'No public key file matches the SSH alias IdentityFile'
  exit 66
}
[[ "$public_key_path" == /* && -f "$public_key_path" && -r "$public_key_path" ]] || {
  print -u2 -r -- "public key file is missing or unreadable: $public_key_path"
  exit 66
}
public_key=$(/usr/bin/awk 'NF { print; exit }' "$public_key_path")
key_fields=(${=public_key})
if (( ${#key_fields} < 2 )) || [[ "$key_fields[1]" != ssh-* && "$key_fields[1]" != ecdsa-* && "$key_fields[1]" != sk-* ]]; then
  print -u2 'public key file does not contain a supported SSH public key'
  exit 65
fi

route_info=$(route -n get "$guest_ip" 2>/dev/null) || { print -u2 'could not resolve the Mac route to the VM'; exit 71; }
route_interface=$(print -r -- "$route_info" | /usr/bin/awk '$1 == "interface:" { print $2; exit }')
[[ -n "$route_interface" ]] || { print -u2 'VM route has no Mac interface'; exit 71; }
host_address=$(ipconfig getifaddr "$route_interface" 2>/dev/null) || {
  print -u2 -r -- "Mac interface has no IPv4 address: $route_interface"
  exit 71
}
[[ "$host_address" == <->.<->.<->.<-> ]] || { print -u2 'Mac route returned an invalid IPv4 address'; exit 65; }

host_temp=$(mktemp -d -t windows-vm-recover-ssh.XXXXXX) || { print -u2 'could not create host temporary directory'; exit 73; }
trap 'rm -rf -- "$host_temp"' EXIT
guest_seed=''
guest_public_key=''
guest_script=''
guest_started=''
guest_result_path=''

guest_files() {
  reply=("$guest_seed" "$guest_public_key" "$guest_script" "$guest_started" "$guest_result_path")
}

cleanup_guest_files() {
  local guest_file
  integer failed=0
  "$vmrun" listProcessesInGuest >/dev/null 2>&1 || return 1
  guest_files
  for guest_file in "${reply[@]}"; do
    [[ -n "$guest_file" ]] || continue
    if "$vmrun" fileExistsInGuest "$guest_file" >/dev/null 2>&1; then
      "$vmrun" deleteFileInGuest "$guest_file" >/dev/null 2>&1 || failed=1
    fi
  done
  return "$failed"
}

read_guest_pid() {
  guest_pid=''
  "$vmrun" fileExistsInGuest "$guest_started" >/dev/null 2>&1 || return 1
  "$vmrun" copyFileFromGuestToHost "$guest_started" "$host_temp/started.json" >/dev/null 2>&1 || return 1
  guest_pid=$(/usr/bin/plutil -extract pid raw -o - "$host_temp/started.json" 2>/dev/null) || guest_pid=''
}

stop_guest_process() {
  read_guest_pid || return 0
  [[ "$guest_pid" == <-> ]] && "$vmrun" killProcessInGuest "$guest_pid" >/dev/null 2>&1 || true
}

finish_with_cleanup() {
  local requested_exit=$1
  if ! cleanup_guest_files; then
    print -u2 -r -- "cleanup=unverified guest_script=${guest_script:-unknown}"
    exit 76
  fi
  exit "$requested_exit"
}

on_signal() {
  local signal_exit=$1
  stop_guest_process
  cleanup_guest_files || print -u2 -r -- "cleanup=unverified guest_script=${guest_script:-unknown}"
  exit "$signal_exit"
}
trap 'on_signal 130' INT
trap 'on_signal 143' TERM
trap 'on_signal 129' HUP

guest_seed=$("$vmrun" createTempFileInGuest 2>"$host_temp/guest-ops.err")
if (( $? != 0 )); then
  /bin/cat "$host_temp/guest-ops.err" >&2
  print -u2 'guest_operations=create-temp-failed'
  exit 71
fi
guest_seed=${guest_seed//$'\r'/}
[[ -n "$guest_seed" && "$guest_seed" != *$'\n'* ]] || { print -u2 'guest_operations=invalid-temp-path'; exit 71; }
guest_script="${guest_seed}.restore-openssh.ps1"
guest_public_key="${guest_seed}.public-key.pub"
guest_started="${guest_seed}.started.json"
guest_result_path="${guest_seed}.result.json"

if ! "$vmrun" copyFileFromHostToGuest "$public_key_path" "$guest_public_key"; then
  print -u2 'guest_operations=copy-public-key-failed'
  finish_with_cleanup 71
fi
if ! "$vmrun" copyFileFromHostToGuest "$restore_script" "$guest_script"; then
  print -u2 'guest_operations=copy-script-failed'
  finish_with_cleanup 71
fi
if ! "$vmrun" runProgramInGuest -noWait \
  'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe' \
  -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass \
  -File "$guest_script" \
  -UserName "$windows_user" \
  -PublicKeyPath "$guest_public_key" \
  -HostAddress "$host_address" \
  -StartedPath "$guest_started" \
  -ResultPath "$guest_result_path"; then
  print -u2 'guest_operations=launch-failed'
  finish_with_cleanup 71
fi

integer deadline=$(( SECONDS + timeout_seconds ))
result_ready=0
while (( SECONDS < deadline )); do
  if "$vmrun" fileExistsInGuest "$guest_result_path" >/dev/null 2>&1; then
    result_ready=1
    break
  fi
  sleep 1
done

if (( ! result_ready )); then
  print -u2 -r -- "recovery_timeout=${timeout_seconds}s"
  stop_guest_process
  finish_with_cleanup 124
fi

host_result="$host_temp/result.json"
if ! "$vmrun" copyFileFromGuestToHost "$guest_result_path" "$host_result"; then
  print -u2 'guest_operations=copy-result-failed'
  stop_guest_process
  finish_with_cleanup 71
fi

recovery_status=$(/usr/bin/plutil -extract status raw -o - "$host_result" 2>/dev/null) || recovery_status=''
recovery_code=$(/usr/bin/plutil -extract code raw -o - "$host_result" 2>/dev/null) || recovery_code=''
/bin/cat "$host_result"
print

case "$recovery_status" in
  ok)
    if ! cleanup_guest_files; then
      print -u2 -r -- "cleanup=unverified guest_script=$guest_script"
      exit 76
    fi
    verification=$("$status_script" --ssh "$ssh_host" --require ssh --wait 15 2>&1)
    verification_result=$?
    if (( verification_result == 0 )); then
      print -r -- "$verification"
      exit 0
    fi
    print -u2 -r -- "$verification"
    print -u2 'recovery=applied ssh=unverified'
    exit 75
    ;;
  error)
    [[ "$recovery_code" == administrator_required ]] && finish_with_cleanup 77
    finish_with_cleanup 75
    ;;
  *)
    print -u2 'recovery_result=invalid'
    finish_with_cleanup 75
    ;;
esac
