#!/usr/bin/env python3
"""Run existing helpers with durable results, raw evidence, and conservative recovery status."""
import argparse
import base64
import datetime
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import threading
import tempfile
import uuid

SCRIPTS = Path(__file__).resolve().parent
HELPERS = {'powershell': 'windows-vm-powershell', 'interactive': 'windows-vm-interactive-run'}


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def identity(pid):
    try:
        r = subprocess.run(['ps', '-p', str(pid), '-o', 'lstart='], capture_output=True, text=True)
        return r.stdout.strip() or None
    except OSError:
        return None


def save(path, record):
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(record, indent=2) + '\n')
    temporary.chmod(0o600)
    temporary.replace(path)


def classify(code, events, envelope=None):
    terminal = next((e for e in reversed(events) if e.get('event') == 'completed'), envelope)
    cleanup = next((e['status'] for e in reversed(events) if e.get('event') == 'cleanup'),
                   'confirmed' if code == 0 else 'unknown')
    completion = 'confirmed' if terminal is not None or code == 0 else 'unknown'
    if terminal and terminal.get('timed_out'):
        state = 'timed_out'
    elif code == 0:
        state = 'succeeded'
    elif terminal is not None:
        state = 'failed'
    else:
        state = 'unknown' if code == 76 or code < 0 else ('timed_out' if code == 124 else 'failed')
    return state, completion, cleanup, terminal


def main():
    p = argparse.ArgumentParser(description=__doc__)
    sub = p.add_subparsers(dest='action', required=True)
    run = sub.add_parser('run')
    run.add_argument('--record', help='optional new absolute directory; defaults to a private temporary directory')
    run.add_argument('kind', choices=HELPERS)
    run.add_argument('arguments', nargs=argparse.REMAINDER)
    status = sub.add_parser('status')
    status.add_argument('record', help='announced task directory (or its result.json file)')
    status.add_argument('--probe', action='store_true', help='read-only Windows process identity check via configured SSH')
    a = p.parse_args()
    directory = Path(a.record) if a.record else Path(tempfile.mkdtemp(prefix='windows-task-')).resolve()
    if not directory.is_absolute():
        p.error('record directory must be absolute')
    path = directory if a.action == 'status' and directory.name == 'result.json' else directory/'result.json'
    if a.action == 'status':
        try:
            record = json.loads(path.read_text())
        except (OSError, ValueError) as error:
            p.error(f'cannot read task record: {error}')
        if record['state'] == 'running':
            live = bool(record['host']['started']) and identity(record['host']['pid']) == record['host']['started']
            record['host_alive'] = live
            record['next_step'] = ('Read the task output; the host runner is still active.' if live else
                'Host runner identity cannot be confirmed. Inspect guest process identities and effects before retrying; completion is unknown.')
            if not live:
                record.update(state='unknown', completion='unknown', cleanup='unknown')
        if a.probe:
            processes = [e for e in record.get('guest', []) if e.get('event') == 'started' and e.get('created')]
            if processes:
                data = base64.b64encode(json.dumps(processes).encode()).decode()
                source = '''$ErrorActionPreference='Stop'
$items=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('PAYLOAD')) | ConvertFrom-Json
$rows=@(foreach ($item in $items) {
 $state='wrong_host'
 if ($env:COMPUTERNAME -eq $item.computer) {
  try {
   $process=Get-Process -Id $item.pid -ErrorAction SilentlyContinue
   $state='not_found'
   if ($process) {
    $state='different_process'
    if ($process.StartTime.ToUniversalTime().ToString('o') -eq $item.created) { $state='running' }
   }
  } catch { $state='unavailable' }
 }
 [pscustomobject]@{pid=$item.pid; state=$state; computer=$env:COMPUTERNAME}
})
ConvertTo-Json -InputObject $rows -Compress
'''.replace('PAYLOAD', data)
                with tempfile.TemporaryDirectory(prefix='windows-task-status-') as tmp:
                    script = Path(tmp)/'probe.ps1'
                    script.write_text(source, encoding='utf-8-sig')
                    aliases = {e['ssh'] for e in record['guest'] if e.get('ssh')}
                    if len(aliases) > 1:
                        record['probe_error'] = 'Multiple SSH targets recorded; inspect each target explicitly.'
                    else:
                        alias = ['--ssh', next(iter(aliases))] if aliases else []
                        try:
                            result = subprocess.run([str(SCRIPTS/'windows-vm-powershell'), *alias, '--timeout', '15', str(script)], capture_output=True, text=True, timeout=100)
                            if result.returncode: raise ValueError(result.stderr)
                            record['process_observations'] = json.loads(result.stdout)
                            record['probe_note'] = 'Process identity only. An absent root does not prove descendants stopped or effects rolled back.'
                        except (OSError, subprocess.SubprocessError, ValueError) as error:
                            record['probe_error'] = str(error)
            else:
                record['probe_note'] = 'No guest process identity recorded. Inspect task output and partial effects.'
        record['observed_at'] = now()
        print(json.dumps(record, indent=2))
        return 0
    try:
        if a.record:
            directory.mkdir(mode=0o700, parents=False, exist_ok=False)
    except OSError as error:
        p.error(f'cannot create new record directory: {error}')
    arguments = a.arguments[1:] if a.arguments[:1] == ['--'] else a.arguments
    if a.kind == 'interactive':
        if '--result' in arguments:
            p.error('the wrapper stores interactive results in its record directory; omit --result')
        arguments = ['--result', str(directory/'interactive.json'), *arguments]
    record = dict(version=1, task_id=uuid.uuid4().hex, kind=a.kind, state='running',
        completion='unknown', cleanup='pending', started_at=now(), exit_code=None,
        host=dict(pid=os.getpid(), started=identity(os.getpid())), guest=[],
        evidence=dict(stdout=str(directory/'stdout.log'), stderr=str(directory/'stderr.log')))
    save(path, record)
    print('task_record=' + str(directory), file=sys.stderr, flush=True)
    lock = threading.Lock()
    events = []
    child = None
    def interrupt(signum, frame):
        if child is not None:
            child.send_signal(signum)
    signal.signal(signal.SIGTERM, interrupt)
    signal.signal(signal.SIGINT, interrupt)
    def pump(stream, target, display):
        with open(target, 'wb') as output:
            os.chmod(target, 0o600)
            pending = b''
            for chunk in iter(lambda: os.read(stream.fileno(), 8192), b''):
                output.write(chunk); output.flush()
                # Forward even partial lines so progress output does not wait for a newline.
                try:
                    display.buffer.write(chunk); display.flush()
                except BrokenPipeError:
                    pass
                pending += chunk
                lines = pending.split(b'\n')
                pending = lines.pop()
                if len(pending) > 1048576:
                    pending = b''
                for line in lines:
                    if not line.startswith(b'windows_task='):
                        continue
                    try:
                        event = json.loads(line[len(b'windows_task='):])
                    except (ValueError, UnicodeError):
                        continue
                    if not isinstance(event, dict):
                        continue
                    with lock:
                        events.append(event)
                        record['guest'] = list(events)
                        save(path, record)
    try:
        child = subprocess.Popen([str(SCRIPTS/HELPERS[a.kind]), *arguments],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            env=dict(os.environ, WINDOWS_VM_TASK_EVENTS='1'))
        threads = [threading.Thread(target=pump, args=(child.stdout, directory/'stdout.log', sys.stdout)),
                   threading.Thread(target=pump, args=(child.stderr, directory/'stderr.log', sys.stderr))]
        for thread in threads: thread.start()
        code = child.wait()
        for thread in threads: thread.join()
    except OSError as error:
        record['error'] = str(error)
        code = 69
    envelope = None
    try:
        if a.kind == 'interactive':
            envelope = json.loads((directory/'interactive.json').read_text(encoding='utf-8-sig'))
            if envelope.get('exit_code') is None:
                envelope = None
    except (OSError, ValueError):
        pass
    state, completion, cleanup, terminal = classify(code, events, envelope)
    record.update(state=state, completion=completion, cleanup=cleanup, exit_code=code, ended_at=now())
    if terminal is not None:
        record['task_exit_code'] = terminal.get('exit_code')
    record['next_step'] = ('Evaluate the recorded output against the requested outcome.' if completion == 'confirmed' else
        'Inspect recorded guest identities and partial effects before repeating a mutation.')
    save(path, record)
    return code if code >= 0 else 128-code

if __name__ == '__main__':
    sys.exit(main())
